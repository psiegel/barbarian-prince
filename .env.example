# Copy to .env and edit. Everything here is optional — with no .env at all,
# `bp speak` falls back to the macOS `say` command and the rest of the CLI works
# normally. .env is git-ignored; this example file is not.
#
#   cp .env.example .env


# ─── Which voice backend ──────────────────────────────────────────────────────
#
#   auto        (default) use the local Kokoro server if it is listening,
#               else ElevenLabs if a key is set, else `say`
#   kokoro      force the local server
#   elevenlabs  force the hosted API
#   say         force the macOS built-in, no model involved
#
# An unreachable backend never hard-fails: it falls back to `say` and says why.
# Override for a single call with `./bp speak <id> --backend <name>`.

BP_TTS=auto


# ─── Local: Kokoro via mlx-audio ──────────────────────────────────────────────
#
# Free and offline. Setup, including the three things that must be installed
# before it will run, is in docs/local-tts.md. Start the server with:
#
#   mlx_audio.server --port 8000
#
# Voice ids are <language><gender>_<name>. British male: bm_george, bm_daniel,
# bm_fable, bm_lewis. American male: am_michael, am_adam, am_onyx, am_fenrir.
# American female: af_heart, af_bella, af_nicole, af_sarah. British female:
# bf_alice, bf_emma, bf_isabella, bf_lily. Full list in docs/local-tts.md.

KOKORO_VOICE=bm_george

# Defaults shown — uncomment only to change them.
#
# Any OpenAI-compatible /v1/audio/speech endpoint works here, not just
# mlx-audio, so point this at Kokoro-FastAPI or similar if you prefer.
#KOKORO_URL=http://127.0.0.1:8000/v1/audio/speech
#KOKORO_MODEL=mlx-community/Kokoro-82M-bf16

# Audio container. The server chooses mp3 unless told otherwise, and `bp` names
# saved files from the response's content-type either way.
#KOKORO_FORMAT=wav


# ─── Hosted: ElevenLabs ───────────────────────────────────────────────────────
#
# Paid. Get a key at https://elevenlabs.io — it needs text-to-speech permission,
# plus voices-read if you want to list voices via the API.
#
# Free accounts can only use `premade` voices; `professional` and library voices
# return HTTP 402, and `bp` then falls back to `say`.
#
# Leave these unset if you are running locally — nothing else refers to them.

#ELEVENLABS_API_KEY=sk_...

# Voice id, not name. JBFqnCBsd6RMkjVDRZzb is George, a warm storyteller that
# suits the narration. Default if unset is 21m00Tcm4TlvDq8ikWAM (Rachel).
#ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Default if unset is eleven_multilingual_v2.
#ELEVENLABS_MODEL=eleven_multilingual_v2
